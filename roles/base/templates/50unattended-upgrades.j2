// Managed by Ansible

// Websites here are not critical, so we prefer fresh Ubuntu packages and
// Caddy over a controlled update schedule. Keep this list explicit so adding
// another APT repository does not silently authorize unattended upgrades
// from it as well.
Unattended-Upgrade::Origins-Pattern {
    "origin=Ubuntu,archive=${distro_codename},label=Ubuntu";
    "origin=Ubuntu,archive=${distro_codename}-updates,label=Ubuntu";
    "origin=Ubuntu,archive=${distro_codename}-security,label=Ubuntu";
    // Ubuntu Pro moves the security updates of the older packages here
    "origin=UbuntuESMApps,archive=${distro_codename}-apps-security";
    "origin=UbuntuESM,archive=${distro_codename}-infra-security";
    // The Caddy repository serves one suite for every Debian and Ubuntu
    "origin=cloudsmith/caddy/stable,archive=any-version";
    // gVisor, the runtime of the pull request previews. Its Release file
    // has no label, so the suite is the only other thing to match on.
    "origin=Google,archive=release";
};

Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// We want as little downtime as possible, so the server never reboots
// on its own. Livepatch fixes the running kernel, and `needrestart`
// restarts the few services which still hold an old library, so an update
// takes effect without a reboot.
//
// A reboot is still needed to switch to a new kernel. The login message
// shows it as `*** System restart required ***`, and we do it by hand
// during a calm hour.
Unattended-Upgrade::Automatic-Reboot "false";
