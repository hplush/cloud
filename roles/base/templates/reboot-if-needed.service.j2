# Managed by Ansible
[Unit]
Description=Reboot the server if Livepatch can't protect the kernel anymore
After=snapd.service

# `unattended-upgrades` creates this file when a new kernel or another
# package requires a reboot. The script then reboots only if Livepatch
# can't patch the running kernel, so most days the timer does nothing.
ConditionPathExists=/run/reboot-required

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/reboot-if-needed
