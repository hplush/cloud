# Managed by Ansible
[Unit]
Description=Check every day whether the kernel needs a reboot

[Timer]
# The server is in UTC. 04:00 UTC is midday in Asia, but night in Europe
# and America, where most of our visitors are.
OnCalendar=*-*-* 04:00:00
# A missed check should wait for the next night instead of rebooting
# right after the server starts at a random hour.
Persistent=false

[Install]
WantedBy=timers.target
