{
  "title": "Slow Reader: Benchmark",
  "uid": "slowreader-benchmark",
  "tags": [
    "slowreader"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1h",
  "time": {
    "from": "now-6M",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cpu",
        "label": "CPU of CI runner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "slowreader-app"
        },
        "definition": "label_values(slowreader_benchmark_duration_seconds,cpu)",
        "query": {
          "qryType": 1,
          "query": "label_values(slowreader_benchmark_duration_seconds,cpu)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Chromium update",
        "datasource": {
          "type": "prometheus",
          "uid": "slowreader-app"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "max by (chromium) (slowreader_benchmark_info) unless max by (chromium) (last_over_time(slowreader_benchmark_info[1d] offset 1d))",
        "step": "1h",
        "titleFormat": "{{chromium}}"
      },
      {
        "name": "Commit of the run",
        "datasource": {
          "type": "prometheus",
          "uid": "slowreader-app"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "max by (commit) (slowreader_benchmark_info) unless max by (commit) (last_over_time(slowreader_benchmark_info[1d] offset 1d))",
        "step": "1h",
        "titleFormat": "{{commit}}"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Last run",
      "datasource": {
        "type": "prometheus",
        "uid": "slowreader-app"
      },
      "targets": [
        {
          "refId": "A",
