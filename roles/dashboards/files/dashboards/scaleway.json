{
  "uid": "slowreader-scaleway",
  "title": "Slow Reader: System",
  "description": "Production containers of Slow Reader from Scaleway Cockpit",
  "tags": [
    "slowreader",
    "scaleway"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "sample",
        "label": "Sample interval",
        "description": "Seconds between samples in Cockpit. Scaleway saves container metrics every 5 seconds: 720 samples per hour.",
        "hide": 2,
        "query": "5"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "App",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Status",
      "description": "Web client and sync server, always one instance. Scaleway does not restart a container in error: it only stops sending requests to it.",
      "datasource": {
        "type": "prometheus",
        "uid": "slowreader-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "slowreader-metrics"
          },
          "expr": "max by (status) (serverless_container_status{resource_name=~\"(.+-)?app\"}) == 1",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU",
      "description": "Share of the CPU limit. Scaleway restarts the container above the limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "slowreader-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "slowreader-metrics"
          },
          "expr": "max(serverless_container_cpu_usage_ratio{resource_name=~\"(.+-)?app\"})",
          "legendFormat": "Max",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "slowreader-metrics"
          },
          "expr": "avg(serverless_container_cpu_usage_ratio{resource_name=~\"(.+-)?app\"})",
          "legendFormat": "Average",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory",
