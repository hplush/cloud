    {
      "id": 6,
      "type": "stat",
      "title": "Instance-hours",
      "description": "Total running time of all instances during the time range. Scaleway bills for this time, multiplied by the CPU and memory of the instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "slowreader-metrics"
      },
      "gridPos": {
        "x": 20,
        "y": 5,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "slowreader-metrics"
          },
          "expr": "sum(count_over_time(serverless_container_memory_usage_bytes{resource_name=~\"(.+-)?app\"}[$__range])) * $sample / 3600 or vector(0)",
          "legendFormat": "Instance-hours",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
