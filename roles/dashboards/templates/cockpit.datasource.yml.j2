# Managed by Ansible
apiVersion: 1

datasources:
  # Cockpit keeps the metrics of Scaleway products for 31 days and answers
  # with Prometheus API
  - name: Slow Reader Metrics
    # Dashboards refer to the data source by it
    uid: slowreader-metrics
    type: prometheus
    url: {{ dashboards_cockpit_url }}/prometheus
    # Changes go through this repository and not through the UI
    editable: false
    jsonData:
      prometheusType: Prometheus
      # Scaleway saves container metrics every 5 seconds, but graphs do not
      # need more than a point per minute. Totals in dashboards do not
      # depend on it: they use the `$sample` constant.
      timeInterval: 1m
      httpHeaderName1: X-Token
    secureJsonData:
      # Grafana replaces it with the variable from the environment file,
      # so the token is not in this file, which every user can read
      httpHeaderValue1: ${SLOWREADER_COCKPIT_TOKEN}
