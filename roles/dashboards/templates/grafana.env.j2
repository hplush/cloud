# Managed by Ansible
# Grafana sets the password only when it creates the account on the first
# start. Changing the file later does not change the password.
GF_SECURITY_ADMIN_PASSWORD={{ dashboards_secrets['admin-password'] }}
GF_SECURITY_SECRET_KEY={{ dashboards_secrets['secret-key'] }}
# The data sources take the tokens from here
SLOWREADER_METRICS_TOKEN={{ dashboards_metrics_token }}
TELEGRAM_TOKEN={{ dashboards_telegram_token }}
