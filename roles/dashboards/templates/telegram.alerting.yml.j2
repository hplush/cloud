# Managed by Ansible
apiVersion: 1

contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: telegram
        type: telegram
        settings:
          chatid: '{{ dashboards_telegram_chat }}'
          # Grafana replaces it with the variable from the environment file
          bottoken: ${TELEGRAM_TOKEN}

policies:
  - orgId: 1
    receiver: Telegram
    group_by:
      - alertname
    routes:
      # All benchmark rules from `rules.alerting.yml.j2` in one message.
      # The benchmark runs once a week, so the message repeats once a week.
      - receiver: Telegram
        object_matchers:
          - ['alertname', '=~', 'Benchmark .*']
        group_by:
          - grafana_folder
        repeat_interval: 1w
