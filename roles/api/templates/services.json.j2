{
{% for app in web_apps %}
  "{{ app.domain }}": {
    "repository": "{{ app.repository }}",
    "workflow_ref": "{{ app.repository }}/.github/workflows/{{ app.workflow }}@refs/heads/{{ app.branch }}",
    "ref": "refs/heads/{{ app.branch }}",
    "requests": "{{ deploy_dir }}/{{ app.domain }}/requests",
    "results": "{{ deploy_dir }}/{{ app.domain }}/results"
  }{{ "," if not loop.last else "" }}
{% endfor %}
}
