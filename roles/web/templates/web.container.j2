# Managed by Ansible
[Unit]
Description={{ app.domain }} ({{ color }} container)
{% if app.database | default(false) %}
After={{ service.user }}-db.service
{% endif %}

[Container]
Image={{ app.image }}
# Only the deploy script downloads images. Without this the container
# could pick up a new `:latest` on a restart, and the server would run
# a version which nobody deployed.
Pull=never
PublishPort=127.0.0.1:{{ app.ports[color] }}:{{ app.container_port }}
{% if app.database | default(false) %}
# The private network with the database. The app takes `DATABASE_URL`
# with the password from the file, so it stays out of this unit.
Network={{ service.user }}.network
EnvironmentFile={{ web_state }}/database/url.env
{% endif %}
{% for name, value in (app.env | default({})).items() %}
{% if loop.first %}
# Settings from the website config. Podman unescapes C-style escapes
# in these values, so every backslash is doubled here.
{% endif %}
Environment="{{ name }}={{ value | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
# A website serves files: it needs no capability, and Podman mounts
# a tmpfs over /run, /tmp, and /var/tmp for a read-only image anyway.
ReadOnly=true
{% for path in app.writable | default([]) %}
{% if loop.first %}
# An image which writes somewhere else asks for the directory in its
# config. It is a tmpfs too: the files die with the container.
{% endif %}
Tmpfs={{ path }}
{% endfor %}
DropCapability=all
NoNewPrivileges=true
# All our images define a `HEALTHCHECK`, and Podman runs it on its own.
# `Restart=always` alone only covers a crash, while an application can also
# hang: `kill` stops such a container, and systemd starts it again.
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5
# The image is already on the disk, but the application inside it
# can take a while to be ready
TimeoutStartSec=300
# One website should not take the whole server down with it. The container
# lives in the cgroup of this unit, so these limits apply to it.
MemoryMax={{ app.memory | default('512M') }}
CPUQuota={{ app.cpu | default('100%') }}
TasksMax={{ app.tasks | default(512) }}

[Install]
WantedBy=default.target
