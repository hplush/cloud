<!-- Managed by Ansible -->
<!--
  The built-in `default` user has an empty password and accepts connections
  from any address. Only Plausible is in the private network, but a bug
  which makes Plausible fetch a URL could still query ClickHouse without
  the password.
-->
<clickhouse>
    <users>
        <default>
            <password remove="remove" />
            <password_sha256_hex>{{ analytics_secrets['clickhouse-password'] | hash('sha256') }}</password_sha256_hex>
        </default>
    </users>
</clickhouse>
